{
  "name": "panvel-sir-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-10",

  // Locked to the Panvel SIR account (practicemail606). If wrangler is
  // logged into any other account, deploys fail instead of going there.
  "account_id": "d2cdff46dfb1c53ee31a738cf6507a70",

  // Public, read-only API. The website is on Firebase (sir.hamzapatel.co.in).
  // Admin is a separate Worker: wrangler.admin.jsonc.
  // The API lives at https://panvel-sir-api.panvel-sir.workers.dev
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true
  },

  "vars": {
    "CF_ACCOUNT_ID": "d2cdff46dfb1c53ee31a738cf6507a70",
    // Websites allowed to call the API from a browser (comma-separated).
    // Local dev doesn't need an entry: Vite forwards /api to `wrangler dev`.
    "ALLOWED_ORIGINS": "https://sir.hamzapatel.co.in,https://panvel-sir-2026.web.app,https://panvel-sir-2026.firebaseapp.com"
  },

  // Per-visitor limit: 100 API calls per minute per IP (per Cloudflare location).
  // Generous on purpose: Indian mobile networks put many people behind one IP.
  // If `wrangler deploy` rejects this block on your plan, delete it; the API
  // still works, just without the rate limit.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 100, "period": 60 }
    },
    // Contact form: 3 messages per minute per IP (on top of Turnstile).
    {
      "name": "CONTACT_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  // No "remote": true here on purpose: `wrangler dev` now uses LOCAL
  // databases and storage, so test imports never spend the live
  // 100k/day write quota. Use `--remote` only when you mean it.
  "d1_databases": [
    {
      "binding": "ASDD_DB",
      "database_name": "panvel-sir-asdd",
      "database_id": "82b03d14-9166-4324-a92e-cb7b7aa55884"
    },
    {
      "binding": "DRAFT_DB",
      "database_name": "panvel-sir-draft",
      "database_id": "cd4ee910-17f4-4ad8-8d09-1a0428eb6758"
    },
    {
      "binding": "FINAL_DB",
      "database_name": "panvel-sir-final",
      "database_id": "f873b934-9999-4811-8207-e71d2d536ee4"
    }
  ],

  "r2_buckets": [
    {
      "binding": "PDF_BUCKET",
      "bucket_name": "panvel-sir-pdfs"
    }
  ]
}
